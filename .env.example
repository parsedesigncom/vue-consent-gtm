# GTM Container ID (Pflicht für die Beispiel-/Demo-App)
# Format: GTM-XXXXXXX
VITE_GTM_ID=GTM-XXXXXXX

# Version der Einwilligung. Erhöhen, um bestehende Zustimmungen zu invalidieren
VITE_CONSENT_VERSION=1

# Gültigkeitsdauer der Einwilligung in Tagen (Standard ~182)
VITE_CONSENT_EXPIRY_DAYS=182

# GTM-Script erst nach Zustimmung laden (true|false)
VITE_LOAD_GTM_ONLY_AFTER_CONSENT=false
